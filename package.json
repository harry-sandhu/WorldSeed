{
  "name": "worldseed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,worker \"next dev\" \"tsx src/simulation-worker/cli.ts --loop\"",
    "dev:web": "next dev",
    "start": "next start",
    "build": "next build",
    "worker:once": "tsx src/simulation-worker/cli.ts",
    "worker:loop": "tsx src/simulation-worker/cli.ts --loop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^18.0.10",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
